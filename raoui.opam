# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A modern terminal console for R built in OCaml"
description:
  "Raoui is an interactive terminal R console with syntax highlighting, completion, inline plotting, and an asynchronous UI/interpreter architecture."
maintainer: ["Alan Lee"]
authors: ["Alan Lee"]
license: "LICENSE"
tags: ["r" "repl" "terminal" "ocaml"]
homepage: "https://github.com/ambientaardvark/raoui"
doc: "https://github.com/ambientaardvark/raoui"
bug-reports: "https://github.com/ambientaardvark/raoui/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml"
  "eio"
  "eio_main"
  "logs"
  "sqlite3"
  "terminal_size"
  "uutf"
  "uuseg"
  "uucp"
  "ptime"
  "sedlex"
  "cmarkit"
  "cohttp-eio"
  "yojson"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ambientaardvark/raoui.git"
x-maintenance-intent: ["(latest)"]
